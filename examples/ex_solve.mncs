mncs 0.11;

// Example: exact 3x3 solve with a machine-checked residual.
//
// For unimodular A (det +/-1) Cramer's rule yields integer solutions;
// this example solves and then proves the answer by computing
// r = A*x - b with checked ops. A nonzero residual or a non-unit
// denominator fails loudly instead of returning a quiet wrong answer.
module ex.solve.v1;

use mncs.math.error.v1;
use mncs.math.scalar.v1;
use mncs.math.linalg.v1;

enum ExOut { Ok { x0: i64, x1: i64, x2: i64, r0: i64, r1: i64, r2: i64 }, Err { reason: i64 } }

fn ex_err(reason: i64) -> (result: ExOut) {
    return ExOut.Err { reason: reason };
}

fn ex_solve3(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64, b0: i64, b1: i64, b2: i64) -> (result: ExOut) {
    let m: [i64; 9] = [a0, a1, a2, a3, a4, a5, a6, a7, a8];
    let s: SolveOut3 = solve3(m, [b0, b1, b2]);
    return match s {
        SolveOut3.Err { reason } => ex_err(reason),
        Ok { x0n, x0d, x1n, x1d, x2n, x2d } => ex_check(m, b0, b1, b2, x0n, x0d, x1n, x1d, x2n, x2d),
    };
}

fn ex_check(m: [i64; 9], b0: i64, b1: i64, b2: i64, x0n: i64, x0d: i64, x1n: i64, x1d: i64, x2n: i64, x2d: i64) -> (result: ExOut) {
    if x0d != 1 {
        return ex_err(reason_domain());
    }
    if x1d != 1 {
        return ex_err(reason_domain());
    }
    if x2d != 1 {
        return ex_err(reason_domain());
    }
    let r0: MathResult = ex_row(m, 0, x0n, x1n, x2n, b0);
    return match r0 {
        MathResult.Err { reason } => ex_err(reason),
        Ok { value: q0 } => ex_check_r1(m, x0n, x1n, x2n, b1, b2, q0),
    };
}

fn ex_row(m: [i64; 9], r: u64, x0: i64, x1: i64, x2: i64, b: i64) -> (result: MathResult) {
    let t0: MathResult = checked_mul(m[r * 3], x0);
    return match t0 {
        MathResult.Err { reason } => MathResult.Err { reason: reason },
        Ok { value: p0 } => ex_row_rest(m, r, p0, x1, x2, b),
    };
}

fn ex_row_rest(m: [i64; 9], r: u64, p0: i64, x1: i64, x2: i64, b: i64) -> (result: MathResult) {
    let t1: MathResult = checked_mul(m[r * 3 + 1], x1);
    return match t1 {
        MathResult.Err { reason } => MathResult.Err { reason: reason },
        Ok { value: p1 } => ex_row_fin(m, r, p0, p1, x2, b),
    };
}

fn ex_row_fin(m: [i64; 9], r: u64, p0: i64, p1: i64, x2: i64, b: i64) -> (result: MathResult) {
    let t2: MathResult = checked_mul(m[r * 3 + 2], x2);
    return match t2 {
        MathResult.Err { reason } => MathResult.Err { reason: reason },
        Ok { value: p2 } => ex_row_sum(p0, p1, p2, b),
    };
}

fn ex_row_sum(p0: i64, p1: i64, p2: i64, b: i64) -> (result: MathResult) {
    let s: MathResult = checked_add(p0, p1);
    return match s {
        MathResult.Err { reason } => MathResult.Err { reason: reason },
        Ok { value: q } => ex_row_dif(q, p2, b),
    };
}

fn ex_row_dif(q: i64, p2: i64, b: i64) -> (result: MathResult) {
    let s: MathResult = checked_add(q, p2);
    return match s {
        MathResult.Err { reason } => MathResult.Err { reason: reason },
        Ok { value: t } => checked_sub(t, b),
    };
}

fn ex_check_r1(m: [i64; 9], x0n: i64, x1n: i64, x2n: i64, b1: i64, b2: i64, q0: i64) -> (result: ExOut) {
    let r1: MathResult = ex_row(m, 1, x0n, x1n, x2n, b1);
    return match r1 {
        MathResult.Err { reason } => ex_err(reason),
        Ok { value: q1 } => ex_check_r2(m, x0n, x1n, x2n, b2, q0, q1),
    };
}

fn ex_check_r2(m: [i64; 9], x0n: i64, x1n: i64, x2n: i64, b2: i64, q0: i64, q1: i64) -> (result: ExOut) {
    let r2: MathResult = ex_row(m, 2, x0n, x1n, x2n, b2);
    return match r2 {
        MathResult.Err { reason } => ex_err(reason),
        Ok { value: q2 } => ExOut.Ok { x0: x0n, x1: x1n, x2: x2n, r0: q0, r1: q1, r2: q2 },
    };
}

fn entry_ex_solve3(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64, b0: i64, b1: i64, b2: i64) -> (result: ExOut) {
    return ex_solve3(a0, a1, a2, a3, a4, a5, a6, a7, a8, b0, b1, b2);
}
