mncs 0.12;

module fprobe.f64array_v1;

fn isum(a: [i64; 8]) -> (result: i64) {
    iterate i over a carrying s: i64 = 0 {
        next s = s + a[i];
    }
    return s;
}

fn entry_i8(x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64) -> (result: i64) {
    return isum([x0, x1, x2, x3, x4, x5, x6, x7]);
}

fn fsum4(a: [f64; 4]) -> (result: f64) {
    iterate i over a carrying s: f64 = 0.0 {
        next s = s + a[i];
    }
    return s;
}

fn entry_f4(a0: f64, a1: f64, a2: f64, a3: f64) -> (result: f64) {
    return fsum4([a0, a1, a2, a3]);
}

fn fsum2(a: [f64; 2]) -> (result: f64) {
    iterate i over a carrying s: f64 = 0.0 {
        next s = s + a[i];
    }
    return s;
}

fn entry_f2(a0: f64, a1: f64) -> (result: f64) {
    return fsum2([a0, a1]);
}

fn entry_loop(a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64) -> (result: f64) {
    let xs: [f64; 6] = [a0, a1, a2, a3, a4, a5];
    iterate i over xs carrying s: f64 = 0.0 {
        next s = s + xs[i];
    }
    return s;
}
