{
 "module": "mncs.math.approx.v1",
 "name": "approx-tolerances",
 "cases": [
  {"id": "abs-exact", "fn": "approx_abs",
   "args": [{"f64": 1.5}, {"f64": 1.5}, {"f64": 0.0}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "abs-close", "fn": "approx_abs",
   "args": [{"f64": 1.0}, {"f64": 1.000000000001}, {"f64": 1e-9}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "abs-far", "fn": "approx_abs",
   "args": [{"f64": 1.0}, {"f64": 2.0}, {"f64": 0.5}],
   "expect": [{"bool": false}], "budget": 4096},
  {"id": "abs-neg-tol", "fn": "approx_abs",
   "args": [{"f64": 1.0}, {"f64": 1.0}, {"f64": -1.0}],
   "expect": [{"bool": false}], "budget": 4096},
  {"id": "abs-negzero", "fn": "approx_abs",
   "args": [{"f64": 0.0}, {"f64": -0.0}, {"f64": 0.0}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "rel-close", "fn": "approx_rel",
   "args": [{"f64": 100.0}, {"f64": 101.0}, {"f64": 0.05}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "rel-far", "fn": "approx_rel",
   "args": [{"f64": 100.0}, {"f64": 110.0}, {"f64": 0.05}],
   "expect": [{"bool": false}], "budget": 4096},
  {"id": "rel-zero", "fn": "approx_rel",
   "args": [{"f64": 0.0}, {"f64": 0.0}, {"f64": 0.01}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "rel-neg-tol", "fn": "approx_rel",
   "args": [{"f64": 1.0}, {"f64": 1.0}, {"f64": -0.5}],
   "expect": [{"bool": false}], "budget": 4096},
  {"id": "eq-abs-wins", "fn": "approx_eq",
   "args": [{"f64": 1.0}, {"f64": 1.000000000001}, {"f64": 1e-9}, {"f64": 1e-18}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "eq-rel-wins", "fn": "approx_eq",
   "args": [{"f64": 1000000.0}, {"f64": 1000001.0}, {"f64": 1e-12}, {"f64": 1e-5}],
   "expect": [{"bool": true}], "budget": 4096},
  {"id": "eq-false", "fn": "approx_eq",
   "args": [{"f64": 1.0}, {"f64": 2.0}, {"f64": 1e-9}, {"f64": 1e-9}],
   "expect": [{"bool": false}], "budget": 4096},
  {"id": "max-abs-basic", "fn": "max_abs",
   "args": [{"f64": -3.0}, {"f64": 2.0}],
   "expect": [{"f64": 3.0}], "budget": 4096},
  {"id": "max-abs-negzero", "fn": "max_abs",
   "args": [{"f64": 0.0}, {"f64": -0.0}],
   "expect": [{"f64": 0.0}], "budget": 4096}
 ]
}
