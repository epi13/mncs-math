    return s.ud;
}

fn entry_lu_P3(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> (result: [i64; 3]) {
    let s: LUS = lu3([a0, a1, a2, a3, a4, a5, a6, a7, a8]);
    return s.p;
}

fn entry_lu_solve3(l0: i64, l1: i64, l2: i64, l3: i64, l4: i64, l5: i64, l6: i64, l7: i64, l8: i64, e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64, e8: i64, u0: i64, u1: i64, u2: i64, u3: i64, u4: i64, u5: i64, u6: i64, u7: i64, u8: i64, f0: i64, f1: i64, f2: i64, f3: i64, f4: i64, f5: i64, f6: i64, f7: i64, f8: i64, p0: i64, p1: i64, p2: i64, n0: i64, n1: i64, n2: i64, d0: i64, d1: i64, d2: i64) -> (result: SubOut3) {
    return lu_solve3([l0, l1, l2, l3, l4, l5, l6, l7, l8], [e0, e1, e2, e3, e4, e5, e6, e7, e8], [u0, u1, u2, u3, u4, u5, u6, u7, u8], [f0, f1, f2, f3, f4, f5, f6, f7, f8], [p0, p1, p2], [n0, n1, n2], [d0, d1, d2]);
}

